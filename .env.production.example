POSTGRES_DB=tiketa
POSTGRES_USER=tiketa
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATABASE_URL=postgresql+asyncpg://tiketa:REPLACE_WITH_URLENCODED_SECRET@db/tiketa
REDIS_URL=redis://:REPLACE_WITH_URLENCODED_SECRET@redis:6379/0
SECRET_KEY=REPLACE_WITH_RANDOM_SIGNING_KEY_AT_LEAST_32_CHARACTERS
APP_FIELD_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
ENVIRONMENT=production
CORS_ORIGINS=["https://tiketa.example.com"]
PUBLIC_BASE_URL=https://tiketa.example.com
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=REPLACE
SMTP_PASSWORD=REPLACE
MAIL_FROM=tiketa@example.com
BACKEND_IMAGE=registry.example.com/tiketa:REVIEWED_COMMIT_SHA
TLS_CERT_DIR=/etc/tiketa/tls
