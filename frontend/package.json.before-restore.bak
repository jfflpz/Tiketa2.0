{
      "name": "tiketa-frontend",
      "private": true,
      "version": "2.1.0",
      "type": "module",
      "scripts": {
            "dev": "vite",
            "test": "tsc --noEmit -p tsconfig.test.json && vitest run --environment jsdom",
            "build": "tsc && vite build",
            "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
            "preview": "vite preview",
            "type-check": "tsc --noEmit"
      },
      "dependencies": {
            "axios": "^1.6.8",
            "clsx": "^2.1.0",
            "html-to-image": "^1.11.13",
            "lucide-react": "^0.363.0",
            "pptxgenjs": "^4.0.0",
            "react": "^18.2.0",
            "react-dom": "^18.2.0",
            "react-router-dom": "^7.18.5",
            "recharts": "^2.12.3",
            "tailwind-merge": "^2.2.2",
            "zustand": "^4.5.2"
      },
      "devDependencies": {
            "@testing-library/react": "^16.3.3",
            "@types/node": "^20.11.30",
            "@types/react": "^18.2.66",
            "@types/react-dom": "^18.2.22",
            "@vitejs/plugin-react": "^4.2.1",
            "autoprefixer": "^10.6.1",
            "jsdom": "^29.1.1",
            "postcss": "^8.5.31",
            "tailwindcss": "^3.4.19",
            "typescript": "^5.4.3",
            "vite": "^8.3.5",
            "vitest": "^5.0.5"
      },
      "allowScripts": {
            "esbuild@0.21.5": true
      }
}
