# Tiketa 2.0 Environment Configuration

# --- APPLICATION & RUNTIME ---
PROJECT_NAME="Tiketa 2.0"
ENVIRONMENT="development"
DEBUG=True

# --- SECURITY & CRYPTOGRAPHY ---
# 64-character random key:
SECRET_KEY="tiketa_dev_secret_key_change_in_production_min_64_characters_long_12345"
# 32-byte Base64 encryption key:
AES_ENCRYPTION_KEY="dGVzdF8zMl9ieXRlX2Jhc2U2NF9lbmNyeXB0aW9uX2tleV9mb3JfZGV2"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 1-CLICK IT PC SETUP KEY ---
DEVICE_SETUP_SECRET="five_star_it_provisioning_key_2026"

# --- POSTGRESQL 16 DATABASE ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=tiketa_db
POSTGRES_USER=tiketa_admin
POSTGRES_PASSWORD=tiketa_secret_dev
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- REDIS 7 CACHE & TOKEN BLACKLIST ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- CORS & ORIGINS ---
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000", "http://localhost", "http://127.0.0.1:5173"]
