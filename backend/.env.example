# Tiketa 2.0 Backend Local Environment Configuration
# Use this configuration when running FastAPI locally on your host machine
# while PostgreSQL and Redis run in Docker (or natively).

# --- APPLICATION & RUNTIME ---
PROJECT_NAME="Tiketa 2.0"
ENVIRONMENT="development"
DEBUG=True

# --- SECURITY & CRYPTOGRAPHY ---
# Minimum 32-character secret key for JWT tokens:
SECRET_KEY="tiketa_dev_secret_key_change_in_production_min_64_characters_long_12345"
# Exactly 32 bytes encoded in Base64 for AES-256-GCM ticket field encryption:
# Generate a new one anytime using: python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
APP_FIELD_ENCRYPTION_KEY="IQsktTIX7ErdFDnCWcjs41B7zJcaLX71PejokEDYlWM="
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 1-CLICK IT PC SETUP KEY ---
DEVICE_SETUP_SECRET="five_star_it_provisioning_key_2026"

# --- POSTGRESQL 16 DATABASE (Local Host Connection) ---
# Note: Use localhost/127.0.0.1 since the Python process runs on your host machine.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tiketa_db
POSTGRES_USER=tiketa_user
POSTGRES_PASSWORD=tiketa_super_secure_password_2026!
DATABASE_URL=postgresql+asyncpg://tiketa_user:tiketa_super_secure_password_2026!@localhost:5432/tiketa_db

# Alternative default credentials (if root .env was not customized):
# DATABASE_URL=postgresql+asyncpg://tiketa_admin:tiketa_secret_dev@localhost:5432/tiketa_db

# --- REDIS 7 CACHE & TOKEN BLACKLIST (Local Host Connection) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- CORS & ORIGINS ---
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000", "http://localhost", "http://127.0.0.1:5173"]
